# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# O .env.local NÃO vai para o Git (está no .gitignore).

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# OBS: as credenciais do Cloudflare R2 (Access Key, Secret) NUNCA ficam no front-end.
# Elas vivem apenas como segredos das Supabase Edge Functions:
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET
