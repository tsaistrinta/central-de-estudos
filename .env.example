# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# O .env.local NÃO vai para o Git (está no .gitignore).
# Sem estas duas linhas o app roda em modo demonstração (dados de exemplo na memória).

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# NUNCA no front-end. Segredos das Edge Functions (npx supabase secrets set ...):
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET=central-de-estudos
# Worker do Archie (Fase 5, arquivo próprio em workers/archie/.env):
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, OLLAMA_URL, ARCHIE_MODEL=qwen3.5:9b
