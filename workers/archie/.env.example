# Worker do Archie — copie para .env (NUNCA vai para o git).

# Supabase → Project Settings → Database → Connection string → "Session pooler" (porta 5432).
# É a conexão direta do worker com o banco (como a service role): guarde só neste PC.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA_DO_BANCO@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Ollama local. Rodando o worker no Docker, use http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
ARCHIE_MODELO=qwen3.5:9b
ARCHIE_MODELO_EMBED=qwen3-embedding:0.6b

# Como o coletor se apresenta aos sites (não finja ser navegador).
ARCHIE_USER_AGENT=CentralDeEstudos-Archie/0.1 (+https://github.com/tsaistrinta/central-de-estudos)

# Ritmo: olha a fila e as fontes vencidas a cada 60 s; espera 5 s entre pedidos ao mesmo site.
ARCHIE_INTERVALO_S=60
ARCHIE_PAUSA_HOST_S=5

# Confiança: >= 0.85 publica sozinho (Oficial); >= 0.6 publica como Provável + curadoria; abaixo, só curadoria.
ARCHIE_CONF_ALTA=0.85
ARCHIE_CONF_MEDIA=0.6

# Criar disciplinas novas lidas da grade sem passar pela curadoria (padrão: não).
ARCHIE_AUTO_ESTRUTURA=false

# Guardar o texto das fontes com embedding (base para a busca/RAG da Fase 6).
ARCHIE_CONHECIMENTO=true

# Moderação do acervo público: o worker baixa o arquivo do Supabase Storage para verificar.
# Supabase → Project Settings → API Keys → "service_role" (secreta: só neste PC, nunca no git nem no front).
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
